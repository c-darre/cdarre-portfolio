<% content_for :title, @case_study.title %>
<% content_for :meta_description,
   truncate((@case_study.context.presence || @case_study.subtitle).to_s, length: 155, separator: " ") %>
<% content_for :og_type, "article" %>
<% if @case_study.hero_image.attached? %>
  <% content_for :og_image, request.base_url + url_for(@case_study.hero_image) %>
<% end %>

<div data-controller="lightbox">
  <article>
    <%# ---------- LANDING : visuel + infos structurées ---------- %>
    <header class="cs-landing" aria-label="<%= @case_study.title %>">
      <div class="csl-media">
        <% if @case_study.hero_image.attached? %>
          <%= image_tag @case_study.hero_image, class: "csl-img",
                alt: attachment_alt(@case_study.hero_image, fallback: @case_study.title) %>
        <% else %>
          <span class="csl-ph mono">Visuel · à venir</span>
        <% end %>
      </div>

      <div class="csl-info">
        <p class="eyebrow mono">Study case</p>
        <h1 class="csl-title"><%= @case_study.title %></h1>
        <% if @case_study.subtitle.present? %>
          <p class="csl-sub"><%= @case_study.subtitle %></p>
        <% end %>

        <dl class="csl-meta">
          <% if @case_study.role.present? %>
            <dt class="mono">Rôle</dt><dd><%= @case_study.role %></dd>
          <% end %>
          <% if @case_study.context.present? %>
            <dt class="mono">Contexte</dt><dd><%= @case_study.context %></dd>
          <% end %>
          <% if @case_study.key_metric.present? %>
            <dt class="mono">Repère</dt>
            <dd><span class="dot">●</span> <%= @case_study.key_metric %></dd>
          <% end %>
        </dl>
      </div>
    </header>

    <%# ---------- CORPS : sommaire sticky + sections ---------- %>
    <div class="cs-body" data-controller="toc">
      <% if @sections.any? %>
        <nav class="cs-toc" aria-label="Sommaire">
          <ol>
            <% @sections.each do |section| %>
              <li>
                <a href="#section-<%= section.id %>" class="cs-toc-link"
                   data-toc-target="link">
                  <%= section.heading.presence || section_type_label(section.section_type) %>
                </a>
              </li>
            <% end %>
          </ol>
        </nav>
      <% end %>

      <div class="cs-sections">
        <% @sections.each do |section| %>
          <section id="section-<%= section.id %>" class="cs-section">
            <p class="sec-label mono"><%= section_type_label(section.section_type) %></p>
            <% if section.heading.present? %><h2><%= section.heading %></h2><% end %>

            <div class="case-prose"><%= section.body %></div>

            <%# Les pages de document (« -doc » dans le nom) sont mises de cote :
                elles vont dans la visionneuse, pas dans la grille. %>
            <% pages, visuels = section.images
                                       .sort_by { |i| i.filename.to_s.downcase }
                                       .partition { |i| i.filename.to_s.downcase.include?("-doc") } %>

            <% if pages.any? %>
              <div class="cs-doc" data-controller="docviewer" tabindex="0"
                   aria-roledescription="document paginé">
                <div class="cs-doc-scene">
                  <% pages.each_with_index do |page, i| %>
                    <%= image_tag page, class: "cs-doc-page", alt: "Page #{i + 1}",
                          loading: i.zero? ? "eager" : "lazy", hidden: !i.zero?,
                          data: { docviewer_target: "page" } %>
                  <% end %>
                </div>

                <div class="cs-doc-barre">
                  <button type="button" class="cs-doc-btn mono"
                          data-action="docviewer#prev"
                          data-docviewer-target="prev"
                          aria-label="Page précédente">←</button>
                  <span class="cs-doc-compteur mono"
                        data-docviewer-target="compteur" aria-live="polite"></span>
                  <button type="button" class="cs-doc-btn mono"
                          data-action="docviewer#next"
                          data-docviewer-target="next"
                          aria-label="Page suivante">→</button>
                </div>
              </div>
            <% end %>

            <%# Les PDF sont sortis de la grille : ils prennent toute la
                largeur de la colonne de texte. %>
            <% pdfs, visuels = visuels.partition { |i| i.content_type.to_s == "application/pdf" } %>

            <% pdfs.each do |pdf| %>
              <figure class="cs-pdf">
                <%# `disposition: :inline` : le PDF s'affiche dans la page au
                    lieu de declencher un telechargement. %>
                <iframe src="<%= rails_blob_path(pdf, disposition: :inline) %>#toolbar=0&navpanes=0&scrollbar=0&view=FitH"
                        title="<%= pdf.filename.to_s %>" loading="lazy"></iframe>
                <figcaption class="cs-pdf-pied mono">
                  <%= link_to "Ouvrir en plein écran ↗",
                        rails_blob_path(pdf, disposition: :inline),
                        target: "_blank", rel: "noopener", class: "lien-discret" %>
                </figcaption>
              </figure>
            <% end %>

            <% if visuels.any? %>
              <%# ORDRE : par nom de fichier. Active Storage n'a pas de champ de
                  position ; nommer les captures « 01-… », « 02-… » suffit donc
                  a les ranger. %>
              <div class="cs-shots">
                <% visuels.each do |image| %>
                  <% l = image.metadata["width"].to_i %>
                  <% h = image.metadata["height"].to_i %>
                  <%# Une video n'expose pas ces metadonnees : on la laisse en
                      colonne normale plutot que de la forcer en pleine largeur. %>
                  <% large = l.positive? && h.positive? && l > h %>
                  <%# TAILLE : suffixe du nom de fichier. « -grand » agrandit,
                      « -plein » occupe toute la largeur du texte. Le suffixe
                      etant en FIN de nom, il ne perturbe pas le tri (01-, 02-). %>
                  <% nom = image.filename.to_s.downcase %>
                  <% taille = if nom.include?("-plein") then "is-plein"
                              elsif nom.include?("-grand") then "is-grand"
                              end %>
                  <figure class="cs-shot <%= "is-paysage" if large %> <%= taille %>">
                    <% if image.content_type.to_s.start_with?("video/") %>
                      <%# Video : meme grammaire que la landing — aucune prise,
                          aucun controle, boucle infinie. Elle remplace un GIF
                          pour un poids sans commune mesure. %>
                      <video class="cs-shot-video" autoplay muted loop playsinline
                             disablepictureinpicture preload="metadata"
                             tabindex="-1" aria-hidden="true"
                             oncontextmenu="return false">
                        <source src="<%= url_for(image) %>"
                                type="<%= image.content_type %>">
                      </video>
                    <% else %>
                      <button type="button" class="shot"
                              data-action="lightbox#open"
                              data-src="<%= url_for(image) %>"
                              data-alt="<%= attachment_alt(image) %>"
                              aria-label="Agrandir : <%= attachment_alt(image) %>">
                        <%= image_tag image, loading: "lazy", alt: attachment_alt(image) %>
                      </button>
                    <% end %>
                  </figure>
                <% end %>
              </div>
            <% end %>
          </section>
        <% end %>
      </div>
    </div>

    <%# ---------- Bas de page ---------- %>
    <nav class="cs-next" aria-label="Navigation entre études">
      <%= link_to "← Back to Study cases", case_studies_path, class: "mono" %>
      <% if @next_case_study %>
        <%= link_to "Next : #{@next_case_study.title} →",
              case_study_path(@next_case_study), class: "next-link" %>
      <% end %>
    </nav>
  </article>

  <%= render "shared/lightbox" %>
</div>
