<% content_for :title, "Galerie" %>
<% content_for :meta_description,
   "Galerie de créations visuelles de Cyprien Darré : identités, concepts, motion design." %>

<%# ---------- LANDING : la phrase seule, plein écran ---------- %>
<section class="gl-landing" aria-label="Galerie visuelle">
  <span class="corner corner-tl mono">Galerie</span>
  <span class="corner corner-tr mono"><%= @visual_works.size %> pièce(s)</span>

  <p class="gl-catchline">De la <span class="inflexion">surface</span> au
    <span class="inflexion">fond</span>, en passant par la
    <span class="inflexion">forme</span>.</p>

  <a class="scroll-cue mono" href="#creations" aria-label="Voir les créations">↓</a>
</section>

<%# ---------- FEED : trois colonnes en maçonnerie ---------- %>
<section id="creations" class="gl-feed-section" aria-label="Créations">
  <% if @visual_works.any? %>
    <%# `columns` en CSS plutot qu'une grille : les hauteurs sont libres et
        les visuels s'empilent sans laisser de trous, sans JavaScript. %>
    <div class="gl-feed" data-controller="lightbox">
      <% @visual_works.each do |work| %>
        <% next unless work.images.attached? %>
        <% image = work.images.first %>
        <figure class="gl-post">
          <% if image.content_type.to_s.start_with?("video/") %>
            <%# Video : lecture automatique, muette, en boucle. Pas de bouton
                d'agrandissement — la visionneuse n'affiche que des images. %>
            <div class="gl-post-media is-video">
              <video autoplay muted loop playsinline preload="metadata"
                     disablepictureinpicture tabindex="-1" aria-hidden="true"
                     oncontextmenu="return false">
                <source src="<%= url_for(image) %>" type="<%= image.content_type %>">
              </video>
            </div>
          <% else %>
            <button type="button" class="gl-post-media"
                    data-action="lightbox#open"
                    data-src="<%= url_for(image) %>"
                    data-alt="<%= attachment_alt(image, fallback: work.display_title) %>"
                    aria-label="Agrandir : <%= work.display_title %>">
              <%= image_tag image, loading: "lazy",
                    alt: attachment_alt(image, fallback: work.display_title) %>
            </button>
          <% end %>

          <%# Legende facultative : sans elle, le visuel vit seul. %>
          <% if work.caption.present? %>
            <figcaption class="gl-post-legende"><%= work.caption %></figcaption>
          <% end %>
        </figure>
      <% end %>
    </div>
  <% else %>
    <p class="ph mono">Créations à venir.</p>
  <% end %>
</section>

<%= render "shared/lightbox" %>
