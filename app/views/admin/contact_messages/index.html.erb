<% content_for :title, "Messages · Admin" %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <h1 class="h3 mb-0">Messages reçus</h1>
  <div class="btn-group">
    <%= link_to "Légitimes (#{@nb_ok})", admin_contact_messages_path,
          class: "btn btn-sm #{@filtre == 'legitimes' ? 'btn-dark' : 'btn-outline-dark'}" %>
    <%= link_to "Indésirables (#{@nb_spam})", admin_contact_messages_path(filtre: "indesirables"),
          class: "btn btn-sm #{@filtre == 'indesirables' ? 'btn-dark' : 'btn-outline-dark'}" %>
  </div>
</div>

<% if @filtre == "indesirables" && @nb_spam > 0 %>
  <%= button_to "Vider les indésirables", purge_admin_contact_messages_path, method: :delete,
        class: "btn btn-sm btn-outline-danger mb-3",
        form: { data: { turbo_confirm: "Supprimer les #{@nb_spam} messages indésirables ?" } } %>
<% end %>

<% if @messages.any? %>
  <div class="list-group">
    <% @messages.each do |message| %>
      <div class="list-group-item py-3">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-2">
          <div>
            <strong><%= message.name %></strong>
            · <%= mail_to message.email, message.email %>
          </div>
          <div class="d-flex align-items-baseline gap-3">
            <span class="small text-body-secondary"><%= l message.created_at, format: :short %></span>
            <%= button_to "Suppr.", admin_contact_message_path(message), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { data: { turbo_confirm: "Supprimer ce message ?" } } %>
          </div>
        </div>
        <%= simple_format message.body, class: "mb-0" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">Aucun message dans cette vue.</p>
<% end %>
