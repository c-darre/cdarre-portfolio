<%# ================= LANDING VIDEO ================= %>
<%# La pile rend le collage possible : la video reste epinglee tant que la
    pile defile, et le bloc (00) monte PAR-DESSUS elle. %>
<div class="landing-stack">
  <% if (video = intro_video_path) %>
    <section class="video-landing" aria-label="Introduction animée">
      <%# Zero interaction : ni controles, ni menu contextuel, ni image dans
          l'image, ni capture du pointeur. La video est purement decorative. %>
      <%# DEUX balises, une seule affichee : `media` sur <source> n'est plus
          honore par Chrome, qui prenait la premiere source lisible — donc la
          version portrait pour tout le monde. Le CSS, lui, est fiable. %>
      <video class="video-landing-media est-paysage" autoplay muted loop playsinline
             disablepictureinpicture disableremoteplayback preload="none"
             tabindex="-1" aria-hidden="true" oncontextmenu="return false">
        <source src="<%= video %>" type="video/mp4">
      </video>

      <% if (video_mobile = intro_video_mobile_path) %>
        <video class="video-landing-media est-portrait" autoplay muted loop playsinline
               disablepictureinpicture disableremoteplayback preload="none"
               tabindex="-1" aria-hidden="true" oncontextmenu="return false">
          <source src="<%= video_mobile %>" type="video/mp4">
        </video>
      <% end %>
      <p class="video-kicker mono">Communication · Design · Code</p>

      <span class="video-cue" aria-hidden="true">
        <svg viewBox="0 0 24 40" width="27" height="45" fill="none"
             stroke="currentColor" stroke-width="1.5">
          <path d="M12 2 V36 M4 28 l8 8 8-8"/>
        </svg>
      </span>
    </section>
  <% end %>

  <%# ================= (00) WORDING ================= %>
  <section class="screen hero" aria-label="Introduction">
    <%# Decor : le meme visuel que le survol « Études de cas » de /travaux.
        `data-controller="reveal"` lui donne la derive au curseur ; aucune
        regle ne lisant `--flou` ici, il reste net. %>
    <%# Sur mobile, c'est le visuel ORANGE qui sert de fond : le survol des
        mots, qui le revele sur grand ecran, n'a pas d'equivalent au doigt. %>
    <% if (deco = works_image("cases")) %>
      <div class="hero-deco" aria-hidden="true" data-controller="reveal">
        <%= image_tag deco, class: "hero-deco-img hero-deco-base", alt: "" %>
        <%# Second calque : apparait au survol d'un mot surligne. %>
        <% if (deco_alt = works_image("gallery")) %>
          <%= image_tag deco_alt, class: "hero-deco-img hero-deco-alt", alt: "" %>
        <% end %>
      </div>
    <% end %>

    <%# Les `h1-l` restent en ligne sur grand ecran et s'empilent sur mobile. %>
    <h1>
      <span class="h1-l">De l'<span class="surligne">idée</span></span>
      <span class="h1-l">à l'<em class="surligne">usage</em> :</span>
      <span class="h1-l"><span class="surligne">concevoir,</span></span>
      <span class="h1-l"><span class="surligne">déployer,</span></span>
      <span class="h1-l"><span class="surligne">faire adopter.</span></span>
    </h1>
  </section>
</div>

<%# ================= (01) PROFIL ================= %>
<section id="profil" class="screen" aria-label="Profil">
  <span class="corner corner-tl mono">(01) · Profil</span>
  <span class="corner corner-tr mono">2014 → 2026</span>

  <div class="profil-grid">
    <div class="profil-media">
    <figure class="frame" data-controller="reveal" data-flou="46" data-derive="9">
      <% if (portrait = about_portrait_path) %>
        <div class="reveal">
          <%# 17 Ko sur mobile au lieu de 178 : le navigateur choisit la version
                utile grace au `srcset`. Repli sur l'original si les variantes
                n'ont pas ete deposees. %>
            <% if Rails.root.join("app/assets/images/portrait-about-400.jpg").exist? %>
              <%= image_tag "portrait-about-800.jpg", class: "reveal-img",
                    srcset: "#{asset_path('portrait-about-400.jpg')} 400w, " \
                            "#{asset_path('portrait-about-800.jpg')} 800w, " \
                            "#{asset_path('portrait-about-1200.jpg')} 1200w",
                    sizes: "(max-width: 720px) 190px, 360px",
                    alt: "Portrait de Cyprien Darré" %>
            <% else %>
              <%= image_tag portrait, class: "reveal-img", alt: "Portrait de Cyprien Darré" %>
            <% end %>
        </div>
      <% end %>
    </figure>

      <p class="profil-lien">
        <%= link_to about_path, class: "lien-discret mono" do %>
          En savoir plus <span class="lien-fleche" aria-hidden="true">→</span>
        <% end %>
      </p>
    </div>

    <div class="profil-text">
      <p class="lead">
        <span class="ld-l">Concevoir</span>
        <span class="ld-l">ce que <span class="inflexion nue surligne">des milliers</span></span>
        <span class="ld-l"><span class="inflexion nue surligne">de personnes</span></span>
        <span class="ld-l">vont utiliser,</span>
        <span class="ld-l">et faire en sorte</span>
        <span class="ld-l">qu'elles <span class="inflexion surligne">l'utilisent.</span></span>
      </p>

      <p>Une expertise <em>hybride</em>, de la stratégie à la production.</p>

      <p>Dix ans en communication et en conception numérique, dont cinq à la
        direction des systèmes d'information de Renault Group. J'y ai piloté la
        communication d'une direction de 368 collaborateurs, en reporting direct
        au vice-président. J'ai conçu et déployé son portail interne, puis formé
        les équipes à le tenir elles-mêmes. En 2026, j'ai obtenu le titre de
        concepteur développeur d'applications web, filière IA, pour comprendre
        de l'intérieur les outils que je fais adopter. J'ai aussi mené la refonte
        d'un portail de services couvrant 35&nbsp;pays et plus de
        100&nbsp;000&nbsp;utilisateurs.</p>

      <div class="facts">
        <div class="fact mono"><span>Pilotage</span><span>Cadrage · Conduite du changement · Adoption · Formation</span></div>
        <div class="fact mono"><span>Communication</span><span>Éditorial · Publications · Réseaux sociaux · UX writing FR/EN</span></div>
        <div class="fact mono"><span>Design</span><span>UX/UI · Design system · Direction artistique · Motion</span></div>
        <div class="fact mono"><span>Ingénierie</span><span>Ruby on Rails · JavaScript · SQL · IA (LLM, RAG)</span></div>
      </div>
    </div>
  </div>

  <a class="scroll-cue mono" href="#travaux" aria-label="Défiler vers les travaux">↓</a>
</section>

<%# ================= (02) TRAVAUX ================= %>
<section id="travaux" class="screen screen-negatif" aria-label="Travaux">
  <span class="corner corner-tl mono">(02) · Travaux</span>
  <span class="corner corner-tr mono">Études de cas</span>

  <p class="index-intro">
    <span class="ii-mot">Questionner,</span>
    <span class="ii-mot">construire,</span>
    <span class="ii-mot">transmettre.</span>
  </p>

  <% if @case_studies.any? %>
    <div class="index">
      <% @case_studies.each_with_index do |case_study, i| %>
        <%= render "case_studies/index_row", case_study: case_study, row_number: i + 1 %>
      <% end %>
    </div>
  <% else %>
    <p>Les études de cas arrivent : rédaction en cours.</p>
  <% end %>

</section>

<%# ================= (04) CONTACT ================= %>
<section id="contact" class="screen contact screen-negatif" aria-label="Contact">
  <span class="corner corner-tl mono">(04) · Contact</span>

  <%= render "shared/contact_deco" %>


  <%= render "shared/contact_body" %>
</section>
